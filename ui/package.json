{
  "name": "drums-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Electron UI for the drum practice engine",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --ozone-platform-hint=auto",
    "build": "electron-vite build",
    "start": "electron . --ozone-platform-hint=auto",
    "mock": "tsx mock/mock-engine.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/ws": "8.18.1",
    "electron": "39.8.10",
    "electron-vite": "4.0.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "ws": "8.18.3"
  },
  "dependencies": {
    "vexflow": "4.2.5"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
